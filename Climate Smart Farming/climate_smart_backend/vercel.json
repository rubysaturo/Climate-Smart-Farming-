{
  "version": 2,
  "builds": [
    {
      "src": "agrismart/wsgi.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/admin/(.*)",
      "dest": "agrismart/wsgi.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "agrismart/wsgi.py"
    },
    {
      "src": "/static/(.*)",
      "dest": "agrismart/wsgi.py"
    },
    {
      "src": "/(.*)",
      "dest": "agrismart/wsgi.py"
    }
  ]
}
