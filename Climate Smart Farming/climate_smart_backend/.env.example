# ── Backend (Railway / Render) ────────────────────────────────────────────────
# Django secret key - generate one at https://djecrety.ir
SECRET_KEY=your-very-secret-key-here

# Set to False in production
DEBUG=False

# Your backend domain (e.g. your-app.railway.app)
ALLOWED_HOSTS=your-backend-domain.railway.app

# Supabase PostgreSQL connection string
# Found in: Supabase → Project Settings → Database → Connection String (URI mode)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Your Vercel frontend URL (allow CORS from it)
CORS_ALLOWED_ORIGINS=https://your-app.vercel.app
