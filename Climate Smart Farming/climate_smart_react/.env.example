# ── Frontend Environment Variables (add these in Vercel Dashboard) ─────────────
# Supabase Project URL - found in: Supabase → Project Settings → API → Project URL
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anon (public) key - found in: Supabase → Project Settings → API → anon/public
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Optional: Django backend URL (only needed for dashboard data)
VITE_API_URL=
