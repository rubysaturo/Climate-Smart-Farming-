# ──────────────────────────────────────────────────────────────────────────────
# Climate Smart Farming — Frontend Environment Variables
# ──────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in the values:
#   cp .env.example .env.local
#
# All variables are prefixed with VITE_ so they are exposed to the client bundle.
# Never commit .env.local — it is already in .gitignore.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ─────────────────────────────────────────────────────────────────

# Django backend API base URL (no trailing slash).
# In development the Vite dev server proxies /api to this target automatically.
# In production this should be your deployed backend URL.
# Examples:
#   http://127.0.0.1:8000          (local Django dev server)
#   https://your-app.onrender.com   (deployed backend)
VITE_API_URL=

# ── Optional — Supabase ──────────────────────────────────────────────────────
# Leave blank to disable Supabase features. The app works fully with just the
# Django backend. When set, Supabase is used for data storage, real-time
# subscriptions, and file uploads. Authentication is always handled by Django.
# After registering through the app, a Supabase user is optionally created
# to enable Supabase-powered features, but login is always via Django JWT.

# Supabase project URL (from your Supabase dashboard → Settings → API).
# Example: https://xpsirvqhvjlspuatpkgf.supabase.co
VITE_SUPABASE_URL=

# Supabase anon/public key (safe for the browser — this is NOT a service role key).
# Found in the same Settings → API section of your Supabase dashboard.
VITE_SUPABASE_ANON_KEY=
